{
  "name": "sim-console",
  "productName": "SIM CONSOLE",
  "private": true,
  "version": "1.0.0",
  "description": "Robot simulator bench: drive a walker, a mecanum sweeper or a quadrotor swarm from the simulator, a real board over USB, Bluetooth or WiFi, or your own Arduino-style code.",
  "author": "Faysal Ali Shah",
  "license": "MIT",
  "homepage": "https://zero-state-logic.github.io/Sim-Console/",
  "repository": "https://github.com/Zero-State-Logic/Sim-Console",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "tsc --noEmit && vitest run && vite build",
    "desktop": "vite build && electron .",
    "desktop:dev": "node electron/dev.cjs",
    "dist": "vite build && electron-builder --publish never",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-three/drei": "9.99.0",
    "@react-three/fiber": "8.15.19",
    "@react-three/postprocessing": "2.16.6",
    "@uiw/react-codemirror": "4.25.12",
    "fflate": "0.8.3",
    "postprocessing": "6.36.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "0.160.1",
    "uplot": "1.6.32",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@types/three": "0.160.0",
    "@types/w3c-web-serial": "1.0.9",
    "@types/web-bluetooth": "0.0.22",
    "@vitejs/plugin-react": "4.2.1",
    "@vitest/coverage-v8": "2.1.9",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vitest": "2.1.9"
  },
  "build": {
    "appId": "io.github.zerostatelogic.simconsole",
    "productName": "SIM CONSOLE",
    "copyright": "Copyright (c) 2026 Faysal Ali Shah",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.ts",
      "!electron/**/*.d.cts",
      "!electron/dev.cjs",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SIM CONSOLE",
      "artifactName": "SIM-Console-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SIM-Console-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "SIM-Console-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "SIM CONSOLE connects to your robot board over Bluetooth Low Energy.",
        "NSBluetoothPeripheralUsageDescription": "SIM CONSOLE connects to your robot board over Bluetooth Low Energy."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Faysal Ali Shah",
      "synopsis": "Robot simulator bench with USB, Bluetooth and WiFi hardware links",
      "artifactName": "SIM-Console-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Zero-State-Logic",
      "repo": "Sim-Console",
      "releaseType": "release"
    }
  }
}
